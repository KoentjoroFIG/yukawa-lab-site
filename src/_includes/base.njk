<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}, {{ site.field }} at {{ site.institution }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#1C1540">
  <link rel="icon" href="/assets/img/mark.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap">
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="masthead">
    <a class="wordmark" href="/" aria-label="{{ site.name }}, home">
      {% include "mark.svg" %}
      <span class="wordmark-name">{{ site.name }}</span>
      <span class="wordmark-sub">{{ site.field }}, {{ site.institution }}</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <a href="/#research">Research</a>
      <a href="/#people">People</a>
      <a href="/#publications">Publications</a>
      <a href="/#news">News</a>
      <a href="{{ site.japanese_site }}" lang="ja" hreflang="ja">日本語</a>
      <a class="nav-cta" href="/#join">Join the lab</a>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <p class="footer-name">{{ site.name }}</p>
        <p>{{ site.school }}<br>{{ site.institution }}</p>
        <address>{{ site.address }}</address>
      </div>
      <div>
        <p class="footer-head">Contact</p>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p><a href="{{ site.facebook }}">Facebook</a></p>
        <p><a href="{{ site.japanese_site }}" lang="ja" hreflang="ja">日本語のサイト</a></p>
      </div>
      <div>
        <p class="footer-head">Supported by</p>
        <ul class="funders">
          {% for f in funding %}<li>{{ f.name }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </footer>

  <script src="/assets/js/site.js" defer></script>
</body>
</html>
