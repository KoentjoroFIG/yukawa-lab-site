---
layout: base.njk
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title" class="hero-title">How chromatin opens decides what a cell becomes.</h1>
    <div class="hero-row">
      <p class="hero-lede">
        We study how the genome is packaged and unpacked in T cells and in disease,
        combining epigenomic experiments with bioinformatics at {{ site.institution }}.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#research">See our research</a>
        <a class="button button-ghost" href="#join">Join the lab</a>
      </div>
    </div>
  </div>

  <figure class="fiber" data-fiber>
    <canvas class="fiber-canvas" role="img"
      aria-label="Animated chromatin fiber: DNA wrapped around histone beads. Where the fiber opens, the beads slide apart, a transcription factor binds the exposed DNA, and an accessibility signal track below rises into a peak."></canvas>
    <figcaption class="fiber-caption">
      <span class="fiber-track-label">Chromatin accessibility</span>
      <span class="fiber-hint" data-fiber-hint>Move along the fiber to open it, the way T cell activation does.</span>
    </figcaption>
  </figure>
</section>

<section id="research" class="section section-light" aria-labelledby="research-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="research-title">Research</h2>
      <p class="section-intro">
        Two questions run through the lab: how immune cells switch genes on by
        remodelling chromatin, and how molecular data can read disease.
      </p>
    </header>
    <div class="themes">
      {% for theme in research %}
      <article class="theme" id="{{ theme.id }}">
        <h3 class="theme-title">{{ theme.title }}</h3>
        <div class="theme-body">
          <p>{{ theme.summary }}</p>
          <ul class="tags" aria-label="Methods">
            {% for m in theme.methods %}<li>{{ m }}</li>{% endfor %}
          </ul>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="publications" class="section section-white" aria-labelledby="pubs-title">
  <div class="wrap">
    <header class="section-head section-head-row">
      <h2 id="pubs-title">Selected publications</h2>
      <p class="section-intro">{% set oldest = publications | last %}{{ publications | length }} publications since {{ oldest.year }}, from germline epigenetics to immune chromatin.</p>
    </header>
    <ol class="pubs">
      {% for pub in publications %}{% if pub.featured %}
      <li class="pub">
        <p class="pub-year">{{ pub.year }}</p>
        <div class="pub-body">
          <h3 class="pub-title"><a href="{{ pub | pubUrl }}">{{ pub.title }}</a></h3>
          <p class="pub-authors">{{ pub.authors | authorList(6) | safe }}</p>
          <p class="pub-journal"><em>{{ pub.journal }}</em> {{ pub.details }}</p>
          {% if pub.notes %}
          <ul class="pub-notes">
            {% for n in pub.notes %}<li>{% if n.url %}<a href="{{ n.url }}">{{ n.text }}</a>{% else %}{{ n.text }}{% endif %}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
      </li>
      {% endif %}{% endfor %}
    </ol>
  </div>
</section>

<section id="people" class="section section-light" aria-labelledby="people-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="people-title">People</h2>
      <p class="section-intro">A small, international team. We work in English and Japanese.</p>
    </header>

    {% for m in members %}{% if m.pi %}
    <article class="pi">
      <div class="portrait portrait-lg">
        <img src="/assets/img/people/{{ m.photo }}" alt="Portrait of {{ m.name }}" width="480" height="512">
      </div>
      <div class="pi-body">
        <h3 class="pi-name">{{ m.name }}<span class="pi-name-ja" lang="ja">{{ m.name_ja }}</span></h3>
        <p class="pi-role">{{ m.role }}</p>
        <p>{{ m.bio }}</p>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
    </article>
    {% endif %}{% endfor %}

    <ul class="members">
      {% for m in members %}{% if not m.pi and not m.alumni %}
      <li class="member">
        <div class="portrait">
          {% if m.photo %}
          <img src="/assets/img/people/{{ m.photo }}" alt="" width="480" height="512" loading="lazy">
          {% else %}
          <span class="monogram" aria-hidden="true">{{ (m.short_name or m.name) | initials }}</span>
          {% endif %}
        </div>
        <h3 class="member-name">{{ m.short_name or m.name }}</h3>
        <p class="member-role">{{ m.role }}{% if m.since %}, since {{ m.since }}{% endif %}</p>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>

<section id="news" class="section section-white" aria-labelledby="news-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="news-title">News</h2>
    </header>
    <ol class="news">
      {% for item in news %}{% if loop.index <= 4 %}
      <li class="news-item">
        <time class="news-date" datetime="{{ item.date }}">{{ item.date | monthYear }}</time>
        <p>{{ item.text }}</p>
      </li>
      {% endif %}{% endfor %}
    </ol>
  </div>
</section>

<section id="join" class="section join" aria-labelledby="join-title">
  <div class="wrap join-grid">
    <div class="join-copy">
      <h2 id="join-title">Join the lab</h2>
      <p class="join-lede">
        We're recruiting graduate students and research interns from Japan and
        overseas. You can work in English, Japanese or both.
      </p>
      <p>The lab is a good fit if you:</p>
      <ul class="join-points">
        <li>want to study epigenetics</li>
        <li>want to learn experimental techniques and computational analysis side by side</li>
      </ul>
      <div class="hero-actions">
        <a class="button button-primary" href="mailto:{{ site.email }}?subject=Joining%20Yukawa%20Lab">Email Dr. Yukawa</a>
        <a class="button button-ghost" href="{{ site.scholarships }}">Scholarships at Ehime University</a>
      </div>
    </div>
    <figure class="join-photo">
      <img src="/assets/img/lab/lab-dinner.jpg" alt="Lab members sharing a meal together at a restaurant" width="1600" height="1528" loading="lazy">
    </figure>
  </div>
</section>

<script src="/assets/js/chromatin.js" defer></script>
